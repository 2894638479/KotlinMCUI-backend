{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${mod_version}",
    "name": "${mod_name}",
    "description": "${mod_description}",
    "authors": [
        "${mod_authors}"
    ],
    "contact": {
        "homepage": "${mod_mcmod}",
        "sources": "${mod_github}",
        "issues": "${mod_issues}"
    },
    "license": "${license}",
    "icon": "${icon}",
    "environment": "*",
