        "main": [
            {
                "value": "io.github.u2894638479.kotlinmcuibackend.Entry"}
        ]
    },
    "depends": {
        "fabricloader": "*",
        "minecraft": "*",
        "java": ">=8",
        "kotlinmcui": "${kotlinmcui_version_range}"
    }
}
